PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/dreamwave
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars
JWT_REFRESH_SECRET=change_this_refresh_secret_also_min_32_chars
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
JWT_EXPIRE=7d
CLIENT_URL=http://localhost:5173
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=45000
MONGO_POOL_SIZE=20
MONGO_POOL_MIN=0
MONGO_CONNECT_TIMEOUT_MS=10000
REQUEST_TIMEOUT_MS=30000
LONG_REQUEST_TIMEOUT_MS=90000
JOB_INTERVAL_MS=3600000
JOB_DELETE_BATCH=1000
ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Dream Wave AI <noreply@dreamwave.ai>"
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
REQUIRE_EMAIL_VERIFIED=false
# Production requires: JWT_REFRESH_SECRET ≠ JWT_SECRET, SMTP_HOST+SMTP_USER+SMTP_PASS,
# https CLIENT_URL (no *), non-localhost MONGODB_URI (or ALLOW_LOCAL_MONGO=1).
# Set BILLING_ENABLED=1 (or STRIPE_SECRET_KEY) to require Stripe secrets + price IDs.
# REQUIRE_EMAIL_VERIFIED defaults to true in production unless explicitly set to false.
# Production defaults RELEASE_CHANNEL=stable when unset.
RELEASE_CHANNEL=stable
NODE_ENV=development
